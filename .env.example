# ==============================================================================
# ENTERPRISE CORE BOILERPLATE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL / Neon Serverless)
# DATABASE_URL uses pooled connection for serverless/edge
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL is used by Prisma CLI for migrations and introspection
DIRECT_URL="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Security & Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars-long"

# Email Service (Nodemailer / SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="sample_user"
SMTP_PASS="sample_pass"
SMTP_FROM="Enterprise Core <noreply@enterprise-core.dev>"

# Storage / Upload Configuration
# Local storage writes to /public/uploads by default
UPLOAD_DIR="./public/uploads"
NEXT_PUBLIC_STORAGE_PROVIDER="local" # local | s3 | cloudinary

# Maintenance Mode Flag (can also be overridden in DB SiteSetting)
MAINTENANCE_MODE="false"

# E-Learning & EdTech Domain Configurations
NEXT_PUBLIC_SITE_NAME="EduCore Academy"
EDUTECH_VIDEO_CDN="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample"
CERTIFICATE_ISSUER_NAME="EduCore Global Tech Academy"
DEFAULT_CURRENCY="VND"
ENABLE_FREE_PREVIEW="true"

# Google Gemini AI Integration (Grounded Assistant)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
